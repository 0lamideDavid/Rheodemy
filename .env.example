# ──────────────────────────────────────────
# Rheodemy Backend — Environment Variables
# Copy this file to .env and fill in values
# NEVER commit .env to version control
# ──────────────────────────────────────────

# ── Server ────────────────────────────────
PORT=4000

# ── Database ──────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/rheodemy?schema=public"

# ── Authentication ────────────────────────
JWT_SECRET="replace_with_a_long_random_secret_string"

# ── FX Configuration (Hardcoded for Demo) ─
# USD to NGN exchange rate (update as needed before demo)
USD_TO_NGN=1600

# ── Rafiki / ILP ──────────────────────────
# Rafiki backend admin API base URL
RAFIKI_BACKEND_URL="http://localhost:3001"

# Rafiki auth server URL
RAFIKI_AUTH_URL="http://localhost:3003"

# ILP wallet address for the platform (Rafiki payment pointer)
PLATFORM_WALLET_ADDRESS="https://rafiki.example.com/rheodemy"

# ── App ───────────────────────────────────
NODE_ENV=development
