# ──────────────────────────────────────────
# Rheodemy Backend — Environment Variables
# Copy this file to .env and fill in values
# NEVER commit .env to version control
# ──────────────────────────────────────────

# ── Server ────────────────────────────────
PORT=4000

# ── Database ──────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/rheodemy?schema=public"

# ── Authentication ────────────────────────
JWT_SECRET="replace_with_a_long_random_secret_string"

# ── FX Configuration (Hardcoded for Demo) ─
# USD to NGN exchange rate (update as needed before demo)
USD_TO_NGN=1600

# ── Open Payments / ILP (Interledger Testnet) ─────────────────────────────────
# The wallet address (payment pointer) for the PLATFORM (receives instructor payments)
# Get this by creating an account at https://wallet.interledger-test.dev
# Example: https://ilp.interledger-test.dev/rheodemy
PLATFORM_WALLET_ADDRESS="https://ilp.interledger-test.dev/your-platform-username"

# The wallet address used as the TEST STUDENT SENDER during local dev/demo
# Create a second account on the testnet for this
# Example: https://ilp.interledger-test.dev/test-student
STUDENT_WALLET_ADDRESS="https://ilp.interledger-test.dev/your-student-username"

# Key ID for signing Open Payments requests
# Found in your testnet wallet dashboard under Developer / API Keys
# Example: https://ilp.interledger-test.dev/rheodemy/keys/abc123
OPEN_PAYMENTS_KEY_ID="https://ilp.interledger-test.dev/your-platform-username/keys/your-key-id"

# Ed25519 private key — base64-encoded, downloaded from testnet dashboard
# Used to cryptographically sign every Open Payments request
OPEN_PAYMENTS_PRIVATE_KEY="your_base64_encoded_ed25519_private_key"

# How often the chunky ticker fires (milliseconds). Default: 3000 = every 3 seconds
TICK_INTERVAL_MS=3000

# How much is charged per tick in USD (e.g. 0.001 = $0.001 per 3s)
PRICE_PER_TICK_USD=0.001

# ── App ───────────────────────────────────
NODE_ENV=development
