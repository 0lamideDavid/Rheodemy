// =============================================================================
// Rheodemy — Prisma Schema
// Phase 1: Full Database Schema (8 models across 3 concerns)
// =============================================================================
// Run:  npx prisma migrate dev --name init
// Then: npx prisma generate
// =============================================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// =============================================================================
// ENUMS
// =============================================================================

enum Role {
  STUDENT
  INSTRUCTOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
}

enum EnrollmentStatus {
  ACTIVE
  DROPPED
  COMPLETED
}

enum ContentType {
  VIDEO
  AUDIO
  EBOOK
}

enum SessionStatus {
  ACTIVE    // lesson is playing, ticks are running
  ENDED     // student stopped the lesson cleanly
  KILLED    // admin kill switch triggered
  FAILED    // ILP payment failed at session end
}

enum PayoutStatus {
  PENDING   // Rafiki call not yet made
  SUCCESS   // ILP transfer confirmed
  FAILED    // Rafiki returned an error
}

enum LedgerAccountKind {
  LEARNER
  CREATOR
  PLATFORM
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

enum TopUpStatus {
  PENDING
  COMPLETED
  FAILED
  EXPIRED
}

// =============================================================================
// CONCERN 1: IDENTITY
// Models: User, Wallet
// =============================================================================

model User {
  id           String     @id @default(uuid())
  firstName    String
  lastName     String
  email        String     @unique
  passwordHash String
  role         Role       @default(STUDENT)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Relations
  wallet      Wallet?
  courses     Course[]          @relation("InstructorCourses")
  enrollments Enrollment[]
  sessions    PaymentSession[]
  bookmarks   Bookmark[]
  progress    CourseProgress[]
  feedbacks   Feedback[]
  ledgerAccounts LedgerAccount[]
  topUps      TopUp[]

  @@index([email])
  @@index([role])
  @@index([status])
  @@map("users")
}

model Wallet {
  id            String   @id @default(uuid())
  userId        String   @unique
  walletAddress String   @unique   // ILP payment pointer (e.g. https://rafiki.../~username)
  provider      String   @default("rafiki")  // future-proofs multi-provider support
  currency      String   @default("USD")
  accessToken   String?                      // stores the ILP access token for this wallet
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([walletAddress])
  @@map("wallets")
}

// Stores platform-level config/secrets (no FK constraints).
// Used for the master ILP access token so the authorize script
// can write it here and Render reads it automatically — no manual
// env var update needed after each token refresh.
model PlatformConfig {
  key       String   @id         // e.g. 'MASTER_STUDENT_TOKEN'
  value     String               // the token or config value
  updatedAt DateTime @updatedAt

  @@map("platform_config")
}

// =============================================================================
// CONCERN 2: CONTENT
// Models: Course, Lesson, Enrollment
// =============================================================================

model Course {
  id             String       @id @default(uuid())
  title          String
  description    String
  instructorId   String
  pricePerMinute Decimal      @db.Decimal(10, 6)  // e.g. 0.001667 USD/min (~$0.10/hr)
  unlockPrice    Decimal?     @default(10.00) @db.Decimal(10, 6) // Rent-to-own lifetime cap
  tier           String       @default("Core")
  currency       String       @default("USD")
  status         CourseStatus @default(DRAFT)
  thumbnailUrl   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Relations
  instructor  User             @relation("InstructorCourses", fields: [instructorId], references: [id])
  lessons     Lesson[]
  enrollments Enrollment[]
  sessions    PaymentSession[]
  bookmarks   Bookmark[]
  progress    CourseProgress[]

  @@index([instructorId])
  @@index([status])
  @@map("courses")
}

model Lesson {
  id          String      @id @default(uuid())
  courseId    String
  title       String
  description String?
  contentUrl  String                          // URL to video/audio content
  contentType ContentType @default(VIDEO)
  durationSec Int                             // lesson length in seconds
  order       Int                             // determines lesson sequence within a course
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Relations
  course   Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sessions PaymentSession[]
  progress CourseProgress[]

  @@unique([courseId, order])                 // no two lessons share the same position
  @@index([courseId])
  @@map("lessons")
}

model Enrollment {
  id         String           @id @default(uuid())
  userId     String
  courseId   String
  status     EnrollmentStatus @default(ACTIVE)
  enrolledAt DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  // Relations
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])                // a student can only enroll in a course once
  @@index([userId])
  @@index([courseId])
  @@map("enrollments")
}

// =============================================================================
// CONCERN 3: PAYMENTS
// Models: PaymentSession, Transaction, Payout
// =============================================================================

model PaymentSession {
  id          String        @id @default(uuid())
  userId      String                              // student watching
  courseId    String
  lessonId    String?
  status      SessionStatus @default(ACTIVE)
  totalPaid   Decimal       @default(0) @db.Decimal(10, 6)  // running total across all ticks
  startedAt   DateTime      @default(now())
  endedAt     DateTime?                           // null while session is active
  killSwitchAt DateTime?                          // set when status flips to KILLED
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Relations
  user         User          @relation(fields: [userId], references: [id])
  course       Course        @relation(fields: [courseId], references: [id])
  lesson       Lesson?       @relation(fields: [lessonId], references: [id])
  transactions Transaction[]

  @@index([userId])
  @@index([status])
  @@index([lessonId])
  @@map("payment_sessions")
}

model Transaction {
  id            String   @id @default(uuid())
  sessionId     String
  amount        Decimal  @db.Decimal(10, 6)      // gross amount charged to student
  platformFee   Decimal  @db.Decimal(10, 6)      // Rheodemy's cut (e.g. 10% of amount)
  netAmount     Decimal  @db.Decimal(10, 6)      // amount → instructor (amount - platformFee)
  currency      String   @default("USD")
  ilpPacketRef  String?                          // ILP reference for the student debit side
  tickIndex     Int                              // which tick number this was (1, 2, 3 …)
  createdAt     DateTime @default(now())

  // Relations
  session PaymentSession @relation(fields: [sessionId], references: [id])
  payout  Payout?                               // one transaction produces one payout attempt

  @@unique([sessionId, tickIndex])
  @@index([sessionId])
  @@map("transactions")
}

model Payout {
  id             String       @id @default(uuid())
  transactionId  String       @unique              // one payout per transaction
  instructorWallet String                          // ILP wallet address funds were sent to
  amount         Decimal      @db.Decimal(10, 6)  // == Transaction.netAmount
  currency       String       @default("USD")
  status         PayoutStatus @default(PENDING)
  ilpPacketRef   String?                          // ILP reference for the instructor credit side
  failureReason  String?                          // populated if status = FAILED
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Relations
  transaction Transaction @relation(fields: [transactionId], references: [id])

  @@index([status])
  @@index([transactionId])
  @@map("payouts")
}

// =============================================================================
// CONCERN 4: PROGRESS, SAVED & COMMUNITY FEEDBACK
// Models: Bookmark, CourseProgress, Feedback
// =============================================================================

model Bookmark {
  id        String   @id @default(uuid())
  userId    String
  courseId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@map("bookmarks")
}

model CourseProgress {
  id             String    @id @default(uuid())
  userId         String
  courseId       String
  lastLessonId   String?
  lastPosition   String?   // e.g. "Module 2: Runtime Validation (14:20)"
  lastSeconds    Int       @default(0)
  minutesLearned Int       @default(0)
  completed      Boolean   @default(false)
  completedDate  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson Lesson? @relation(fields: [lastLessonId], references: [id], onDelete: SetNull)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@map("course_progress")
}

model Feedback {
  id        String   @id @default(uuid())
  userId    String?
  rating    Int
  category  String   @default("monetization")
  comment   String
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("feedback")
}

// =============================================================================
// CONCERN 5: DOUBLE-ENTRY LEDGER & TOP-UPS
// =============================================================================

model LedgerAccount {
  id        String            @id @default(uuid())
  userId    String?
  kind      LedgerAccountKind
  currency  String            @default("USD")
  balance   Decimal           @default(0) @db.Decimal(18, 6)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  user    User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries LedgerEntry[]

  @@unique([userId, kind, currency])
  @@index([userId])
  @@index([kind])
  @@map("ledger_accounts")
}

model LedgerEntry {
  id             String          @id @default(uuid())
  accountId      String
  direction      LedgerDirection
  amount         Decimal         @db.Decimal(18, 6)
  currency       String          @default("USD")
  sessionId      String?
  topUpId        String?
  tickIndex      Int?
  idempotencyKey String          @unique
  description    String?
  createdAt      DateTime        @default(now())

  account LedgerAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([sessionId])
  @@index([topUpId])
  @@map("ledger_entries")
}

model TopUp {
  id          String      @id @default(uuid())
  userId      String
  reference   String      @unique
  amount      Decimal     @db.Decimal(18, 6)
  currency    String      @default("USD")
  provider    String      @default("simulated")
  status      TopUpStatus @default(PENDING)
  providerRef String?
  createdAt   DateTime    @default(now())
  completedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("top_ups")
}
