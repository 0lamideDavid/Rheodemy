{
  "name": "rheodemy-backend",
  "version": "1.0.0",
  "description": "Rheodemy — real-time pay-as-you-learn backend powered by Interledger Protocol",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "npx prisma generate && tsc",
    "start": "npx prisma migrate deploy && node dist/index.js",
    "prisma:migrate": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio",
    "seed": "prisma db seed"
  },
  "prisma": {
    "seed": "node dist/prisma/seed.js"
  },
  "keywords": [
    "edtech",
    "interledger",
    "ilp",
    "rafiki",
    "micropayments"
  ],
  "author": "Rheodemy Team",
  "license": "MIT",
  "dependencies": {
    "@interledger/open-payments": "^6.6.0",
    "@prisma/client": "^5.22.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.9",
    "@types/uuid": "^10.0.0",
    "axios": "^1.7.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "prisma": "^5.22.0",
    "socket.io": "^4.7.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.2",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  }
}